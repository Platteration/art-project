# Copy to server/.dev.vars (ignored by git) for `node server/dev.mjs` and `wrangler dev`.
# Production values are set with `npx wrangler secret put NAME`, never committed.

# Any random string of 32+ characters. `openssl rand -base64 48` makes one.
SESSION_SECRET=

# Google Cloud console -> APIs & Services -> Credentials -> OAuth client (Web application).
# Authorized redirect URI for local work: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe dashboard (test mode while developing): Developers -> API keys.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:8000/api/stripe/webhook` locally,
# or the endpoint's signing secret in Developers -> Webhooks in production.
STRIPE_WEBHOOK_SECRET=

# One Stripe Price id per product in server/catalogue.js. A product without one is not shown.
STRIPE_PRICE_DRAWDRAW_PRO=
STRIPE_PRICE_STUDIO_SUPPORTER=

# Where the DrawDraw app may be sent after sign-in. Expo Go uses exp://, the web build http://.
APP_REDIRECT_SCHEMES=drawdraw,exp,http
