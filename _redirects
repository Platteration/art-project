# Netlify: the repository's own notes and configs are not part of the site.
# (Cloudflare Pages ignores 404 rules; there, publish only the runtime files.)
/README.md        /404.html  404
/SECURITY.md      /404.html  404
/CHANGELOG.md     /404.html  404
/package.json     /404.html  404
/package-lock.json /404.html  404
/scripts/*        /404.html  404
/tests/*          /404.html  404
/fonts/README.md  /404.html  404
/deploy/*         /404.html  404
/docs/*           /404.html  404
/_headers         /404.html  404
/_redirects       /404.html  404
/.htaccess        /404.html  404
/.gitignore       /404.html  404
/.gitattributes   /404.html  404
/.editorconfig    /404.html  404
