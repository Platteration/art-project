# Response headers for Netlify and Cloudflare Pages (both read this file from the publish folder).
# Apache users: see .htaccess. nginx users: see deploy/nginx.conf. The same values are in all three.
#
# frame-ancestors is left out ON PURPOSE: the app is meant to be embedded in other sites' iframes
# (js/app.js works around sandboxed frames). Do not add X-Frame-Options. To limit embedding to
# known sites, append "; frame-ancestors 'self' https://example.com" to the policy below.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' blob:; manifest-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; object-src 'none'; require-trusted-types-for 'script'; trusted-types 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(self), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), clipboard-write=(self)
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: no-cache

# Fonts never change in place (a new version gets a new file name), so they can be cached for a year.
# Fonts are fetched with CORS: the open Access-Control header lets a sandboxed embed (whose origin is opaque) load them.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/img/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/manifest.json
  Cache-Control: no-cache

/LICENSE
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache
